import os
import json, hashlib
import base64
from decimal import Decimal
import boto3
from array import array
from boto3.dynamodb.types import Binary
import math

"""
Lambda to insert a new text entry into the 'dialife-piece-text' DynamoDB table.

Expected input:
- event['body']: JSON string with required fields:
    {
        "UserID": "<string user id>",
        "Privacy": <integer 0-3>,
        "Timestamp": <epoch number>,
        "Txt": "<non-empty string>"
        ... (optional extra attributes)
    }

Function behavior:
- Validates that all required fields exist and are in correct formats.
- Merges UserID and Privacy into a single PK string "uid#privacy".
- Uses Timestamp as the sort key.
- Writes the item to DynamoDB, rejecting duplicates with the same PK+SK.
- Returns HTTP 200 on success, or HTTP 400 with error details if validation fails.
"""

BEDROCK_REGION   = "eu-central-1"
EMBED_MODEL_ID   = "amazon.titan-embed-text-v2:0"  # Titan v2

TAGS_TABLE_NAME  = "dialife-tag-categories"
TAG_PK_PREFIX    = "TAG#"
TAG_TOP_K        = 6
TAG_MIN_SIM      = 0.35

dynamodb = boto3.resource("dynamodb")
table = dynamodb.Table("dialife-piece-text")
tags_table = dynamodb.Table(TAGS_TABLE_NAME)
bedrock = boto3.client("bedrock-runtime", region_name=BEDROCK_REGION)

REQUIRED = {
    "UserID": str,      # non-empty
    "Privacy": int,     # 0..3
    "Timestamp": (int, float),  # epoch-like number
    "Txt": str         # non-empty
}

def embed_text(text: str) -> tuple[bytes, int]:
    # Titan v2 supports flexible dimensions; if you don't specify, it returns default size.
    # Request schema: { "inputText": "...", "dimensions": 1024 }  # optional
    body = json.dumps({
        "inputText": text,
        "dimensions": 256,
        # "normalize": True  # istersen aç; biz zaten Python tarafında normalize ediyoruz
    })
    resp = bedrock.invoke_model(modelId=EMBED_MODEL_ID, body=body)
    payload = json.loads(resp["body"].read())
    # Titan returns {"embedding": [floats...]}
    vec = payload["embedding"]
    dim = len(vec)
    # pack to float32 to save space & avoid Decimal issues
    buf = array("f", (float(x) for x in vec)).tobytes()
    return buf, dim

def _bad_request(msg, details=None):
    body = {"error": msg}
    if details:
        body["details"] = details
    return {"statusCode": 400, "headers": {"Content-Type": "application/json"},
            "body": json.dumps(body)}

def _ok(payload):
    return {"statusCode": 200, "headers": {"Content-Type": "application/json"},
            "body": json.dumps(payload)}

def _get_body(event):
    """Return parsed JSON body (dict). Supports base64 and Decimal for numbers."""
    raw = event.get("body")
    if raw is None:
        raise ValueError("Missing body")
    if event.get("isBase64Encoded"):
        raw = base64.b64decode(raw).decode("utf-8")
    try:
        # Use Decimal to be DynamoDB-safe for numbers
        return json.loads(raw, parse_float=Decimal, parse_int=Decimal)
    except json.JSONDecodeError as e:
        raise ValueError(f"Body is not valid JSON: {str(e)}")

def _validate(item):
    errors = []

    # presence & type checks
    for key, typ in REQUIRED.items():
        if key not in item:
            errors.append(f"Missing required field: {key}")
            continue
        val = item[key]
        if not isinstance(val, typ):
            # With Decimal parsing, Privacy/Timestamp will be Decimal; accept that below
            if key in ("Privacy", "Timestamp") and isinstance(val, Decimal):
                pass
            else:
                errors.append(f"Field {key} must be of type {typ.__name__ if isinstance(typ, type) else 'number'}")

    if errors:
        return errors

    # established that all needed values are present and right type
    # value-level constraints
    user_id = str(item["UserID"]).strip()
    if not user_id:
        errors.append("UserID cannot be empty")

    # Privacy in [0,1,2,3]
    privacy = item["Privacy"]
    if isinstance(privacy, Decimal):
        # ensure integer value
        if privacy != privacy.to_integral_value():
            errors.append("Privacy must be an integer 0..3")
        privacy = int(privacy)
    elif isinstance(privacy, int):
        pass
    else:
        errors.append("Privacy must be an integer 0..3")

    if isinstance(privacy, int) and not (0 <= privacy <= 3):
        errors.append("Privacy must be one of 0,1,2,3")

    # Timestamp must be a positive number
    ts = item["Timestamp"]
    if isinstance(ts, Decimal):
        try:
            # allow fractional seconds, but must be >= 0
            if ts < 0:
                errors.append("Timestamp must be >= 0")
        except Exception:
            errors.append("Timestamp must be a number")
    elif isinstance(ts, REQUIRED.get("Timestamp")):
        if ts < 0:
            errors.append("Timestamp must be >= 0")
    else:
        errors.append("Timestamp must be a number")

    # Text non-empty string
    text = str(item["Txt"])
    if not text.strip():
        errors.append("Txt cannot be empty")

    return errors

# ---- Tagging helpers ---------------------------------------------------
def _cosine_sim(a_f32_bytes: bytes, b_f32_bytes: bytes) -> float:
    a = array("f"); a.frombytes(a_f32_bytes)
    b = array("f"); b.frombytes(b_f32_bytes)
    if len(a) != len(b) or len(a) == 0:
        return 0.0
    dot = 0.0; na = 0.0; nb = 0.0
    for i in range(len(a)):
        ai = float(a[i]); bi = float(b[i])
        dot += ai * bi; na += ai * ai; nb += bi * bi
    if na == 0.0 or nb == 0.0:
        return 0.0
    return dot / (math.sqrt(na) * math.sqrt(nb))

def _to_bytes_256(maybe_b64_or_bin, expected_dim=256) -> bytes:
    """
    Accepts DynamoDB Binary, base64 str, or list[float]; returns float32 bytes.
    """
    if isinstance(maybe_b64_or_bin, (bytes, bytearray)):
        raw = bytes(maybe_b64_or_bin)
    elif hasattr(maybe_b64_or_bin, "value"):  # boto3 Binary
        raw = bytes(maybe_b64_or_bin.value)
    elif isinstance(maybe_b64_or_bin, str):
        raw = base64.b64decode(maybe_b64_or_bin)
    elif isinstance(maybe_b64_or_bin, list):
        raw = array("f", (float(x) for x in maybe_b64_or_bin)).tobytes()
    else:
        raise ValueError("Unknown embedding storage format for tag")
    # Expect 256 * 4 bytes (float32)
    if len(raw) == expected_dim * 8:
        # convert float64->float32 if needed
        arr = array("d"); arr.frombytes(raw)
        raw = array("f", (float(x) for x in arr)).tobytes()
    if len(raw) != expected_dim * 4:
        raise ValueError(f"Embedding bytes length {len(raw)} != {expected_dim*4}")
    return raw

def _load_all_tags() -> list[dict]:
    """
    Returns items with at least: PK/NAME and one of EmbeddingB/Embedding and EmbedDim.
    - If TAGS_TABLE is separate, we just scan it.
    - If TAGS_TABLE is same as posts table, we scan with begins_with(PK, 'TAG#').
    For small catalogs this is fine; switch to Query if you add a GSI for tags.
    """
    from boto3.dynamodb.conditions import Attr, Key

    # separate tags table: read META rows
    resp = tags_table.scan(
        FilterExpression=Attr("SK").eq("META"),
        ProjectionExpression="PK, TagName, EmbeddingB, Dim"
    )
    return resp.get("Items", [])

def _select_tags_for_embedding(post_emb_bytes: bytes) -> tuple[list[str], dict]:
    """
    Compute cosine similarity to each tag vector and return (Tags, TagScores).
    TagScores values are Decimal so they store cleanly in DynamoDB.
    """
    items = _load_all_tags()
    scored = []
    for it in items:
        emb_payload = it.get("EmbeddingB") or it.get("Embedding")
        if not emb_payload:
            continue
        try:
            tag_emb = _to_bytes_256(emb_payload, expected_dim=256)
        except Exception:
            continue
        sim = _cosine_sim(post_emb_bytes, tag_emb)

        # choose a display name
        tag_name = it.get("TagName") or it.get("NAME") or it.get("Name") or it.get("PK")
        if isinstance(tag_name, str) and tag_name.startswith(TAG_PK_PREFIX):
            tag_name = tag_name[len(TAG_PK_PREFIX):]
        scored.append((tag_name, sim))

    picked = [p for p in scored if p[1] >= TAG_MIN_SIM]
    picked.sort(key=lambda x: x[1], reverse=True)
    picked = picked[:TAG_TOP_K]

    tags = [t for (t, _) in picked]
    scores = {t: Decimal(str(s)) for (t, s) in picked}
    return tags, scores
#

def lambda_handler(event, context):
    try:
        body = _get_body(event)
    except ValueError as e:
        return _bad_request(str(e))

    errors = _validate(body)
    if errors:
        return _bad_request("Validation failed", errors)

    # Optional: enforce idempotency / prevent accidental overwrite.
    # If your table keys are (UserID or UserPrivacy, Timestamp), uncomment and adapt:

    # Merge UserID and Privacy into single UserID
    original_uid = str(body["UserID"]).strip()
    privacy_val = int(body["Privacy"])
    body["UserID"] = f"{original_uid}#{privacy_val}"

    # Remove original Privacy field if you don't want it stored separately
    body.pop("Privacy", None)

    text = body["Txt"]

    emb_bytes, emb_dim = embed_text(text)
    text_digest = hashlib.sha1(text.encode("utf-8")).hexdigest()

    body["EmbedTextHash"] = text_digest
    body["EmbeddingB"] = Binary(emb_bytes)    # float32-packed vector
    # Helpful metadata:
    body["EmbedDim"] = emb_dim

    try:
        tags, scores = _select_tags_for_embedding(emb_bytes)
        if tags:
            body["Tags"] = tags
            body["TagScores"] = scores  # optional, helpful for debugging/analytics
    except Exception as e:
        body["TaggingError"] = str(e)[:300]

    put_kwargs = {
        "Item": body,
        "ConditionExpression": "attribute_not_exists(#pk)",
        "ExpressionAttributeNames": {"#pk": "UserID"}
    }
    try:
        table.put_item(**put_kwargs)
    except dynamodb.meta.client.exceptions.ConditionalCheckFailedException:
        return _bad_request("An item with the same key already exists")

    return _ok({"message": "Entry created"})
