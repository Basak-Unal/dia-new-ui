TAGS_TABLE_NAME  = os.environ.get("TAGS_TABLE", "dialife-tag-categories")
TAG_TOP_K        = int(os.environ.get("TAG_TOP_K", "3"))        # how many tags to try
TAG_MIN_SIM      = float(os.environ.get("TAG_MIN_SIM", "0.35")) # min cosine to accept a tag
TAG_EMBED_DIM    = int(os.environ.get("TAG_EMBED_DIM", "256"))  # must match how you embed tags

