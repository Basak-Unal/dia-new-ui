# Retrieval knobs
TOP_K = int(os.environ.get("TOP_K", "5"))
BATCH_LIMIT = int(os.environ.get("BATCH_LIMIT", "5"))             # items per DDB page
MAX_FRIEND_BATCHES = int(os.environ.get("MAX_FRIEND_BATCHES", "5"))
MAX_PHASE_A_BATCHES = int(os.environ.get("MAX_PHASE_A_BATCHES", "2"))  # user’s private batches

# Privacy mapping
PRIV = {
    "PRIVATE": 3,
    "CLOSE_FRIENDS": 2,
    "FRIENDS": 1,
